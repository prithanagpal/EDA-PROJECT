{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: EchoSense Vellore Server (Port 5001)",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "app.main:app",
                "--host",
                "127.0.0.1",
                "--port",
                "5001",
                "--reload"
            ],
            "cwd": "${workspaceFolder}/backend",
            "jinja": true,
            "justMyCode": false
        }
    ]
}
